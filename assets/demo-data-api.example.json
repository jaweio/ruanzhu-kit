{
  "base_url": "http://127.0.0.1:8000",
  "headers_env": {
    "Authorization": "RUANZHU_LOCAL_AUTH"
  },
  "requests": [
    {
      "name": "创建业务记录",
      "method": "POST",
      "path": "/api/records",
      "payload": {
        "title": "{{业务名称}}",
        "description": "{{业务说明}}",
        "status": "{{状态}}"
      },
      "id_path": "data.id",
      "rollback": {
        "method": "DELETE",
        "path": "/api/records/{{id}}"
      }
    }
  ]
}
